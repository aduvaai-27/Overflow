<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.orderflow.controller.SupplierController" fitToWidth="true">
<VBox spacing="15" style="-fx-padding: 0 4 20 0;">

    <Label text="Suppliers - Companies you buy stock from" styleClass="section-title"/>

    <GridPane hgap="10" vgap="10" styleClass="stat-card">
        <columnConstraints>
            <ColumnConstraints minWidth="80"/>
            <ColumnConstraints minWidth="200"/>
            <ColumnConstraints minWidth="80"/>
            <ColumnConstraints minWidth="200"/>
        </columnConstraints>

        <Label text="Company" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Phone" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Email" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Address" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="addressField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Categories Supplied" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <FlowPane fx:id="categoryCheckboxBox" hgap="14" vgap="6" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

        <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="4">
            <Button text="Add Company" styleClass="button-primary" onAction="#handleAddSupplier"/>
            <Button text="Update Selected" styleClass="button-secondary" onAction="#handleUpdateSupplier"/>
            <Button text="Delete Selected" styleClass="button-danger" onAction="#handleDeleteSupplier"/>
            <Button text="Clear Form" styleClass="button-secondary" onAction="#handleClearSupplierForm"/>
        </HBox>
    </GridPane>

    <TableView fx:id="supplierTable" prefHeight="150">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nameColumn" text="Company" prefWidth="160"/>
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="110"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="160"/>
            <TableColumn fx:id="addressColumn" text="Address" prefWidth="160"/>
            <TableColumn fx:id="categoriesColumn" text="Categories" prefWidth="180"/>
        </columns>
    </TableView>

    <Label text="Request Stock From a Supplier" styleClass="section-title"/>

    <GridPane hgap="10" vgap="10" styleClass="stat-card">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints minWidth="200"/>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints minWidth="200"/>
        </columnConstraints>

        <Label text="Supplier" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="supplierCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Product" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <ComboBox fx:id="productCombo" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="200"/>

        <Label fx:id="productHintLabel" text="Choose a supplier to see only the products they provide."
               GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.columnSpan="2"
               wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>

        <Label text="Quantity" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Spinner fx:id="qtySpinner" GridPane.rowIndex="2" GridPane.columnIndex="1" editable="true" prefWidth="120"/>

        <Label text="Unit Cost (Tk)" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="unitCostField" GridPane.rowIndex="2" GridPane.columnIndex="3" prefWidth="120"/>

        <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="4">
            <Button text="Send Request" styleClass="button-primary" onAction="#handleSendRequest"/>
        </HBox>
    </GridPane>

    <Label text="Restock Requests" styleClass="section-title"/>

    <HBox spacing="10">
        <Button text="Advance Phase" styleClass="button-secondary" onAction="#handleAdvancePhase"/>
        <Button text="Refresh" styleClass="button-secondary" onAction="#handleRefresh"/>
    </HBox>

    <TableView fx:id="requestTable" prefHeight="240">
        <columns>
            <TableColumn fx:id="reqIdColumn" text="Req #" prefWidth="55"/>
            <TableColumn fx:id="reqSupplierColumn" text="Supplier" prefWidth="150"/>
            <TableColumn fx:id="reqProductColumn" text="Product" prefWidth="150"/>
            <TableColumn fx:id="reqQtyColumn" text="Qty" prefWidth="60"/>
            <TableColumn fx:id="reqUnitCostColumn" text="Unit Cost (Tk)" prefWidth="100"/>
            <TableColumn fx:id="reqTotalCostColumn" text="Total Cost (Tk)" prefWidth="110"/>
            <TableColumn fx:id="reqPhaseColumn" text="Phase" prefWidth="100"/>
            <TableColumn fx:id="reqDateColumn" text="Requested On" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>
</ScrollPane>
