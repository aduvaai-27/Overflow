<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderflow.controller.SupplierController" spacing="12">

    <VBox spacing="2">
        <Label text="Suppliers" styleClass="section-title"/>
        <Label text="Companies you buy stock from, and the restock requests you send them." styleClass="page-subtitle"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab text="Companies">
            <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                <VBox spacing="12" style="-fx-padding: 14 10 14 10;">
                    <HBox styleClass="panel" spacing="18" alignment="CENTER_LEFT">
                        <GridPane hgap="14" vgap="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            </columnConstraints>
                            <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label text="Company" styleClass="field-label"/>
                                <TextField fx:id="nameField"/>
                            </VBox>
                            <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Label text="Phone" styleClass="field-label"/>
                                <TextField fx:id="phoneField"/>
                            </VBox>
                            <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="2">
                                <Label text="Email" styleClass="field-label"/>
                                <TextField fx:id="emailField"/>
                            </VBox>
                            <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="3">
                                <Label text="Address" styleClass="field-label"/>
                                <TextField fx:id="addressField"/>
                            </VBox>
                            <VBox spacing="3" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="4">
                                <Label text="Categories Supplied" styleClass="field-label"/>
                                <FlowPane fx:id="categoryCheckboxBox" hgap="14" vgap="6"/>
                            </VBox>
                        </GridPane>
                        <VBox spacing="8" minWidth="150" prefWidth="150">
                            <Button text="Add Company" styleClass="button-primary" maxWidth="Infinity" onAction="#handleAddSupplier"/>
                            <Button text="Update Selected" styleClass="button-secondary" maxWidth="Infinity" onAction="#handleUpdateSupplier"/>
                            <Button text="Delete Selected" styleClass="button-danger" maxWidth="Infinity" onAction="#handleDeleteSupplier"/>
                            <Button text="Clear Form" styleClass="button-link" maxWidth="Infinity" onAction="#handleClearSupplierForm"/>
                        </VBox>
                    </HBox>

                    <TableView fx:id="supplierTable" prefHeight="230">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="nameColumn" text="Company" prefWidth="160"/>
                            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="110"/>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="160"/>
                            <TableColumn fx:id="addressColumn" text="Address" prefWidth="160"/>
                            <TableColumn fx:id="categoriesColumn" text="Categories" prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab text="Restock Requests">
            <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                <VBox spacing="12" style="-fx-padding: 14 10 14 10;">
                    <VBox styleClass="panel" spacing="10">
                        <Label text="New Request" styleClass="panel-title"/>
                        <HBox spacing="14" alignment="BOTTOM_LEFT">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Supplier" styleClass="field-label"/>
                                <ComboBox fx:id="supplierCombo" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Product" styleClass="field-label"/>
                                <ComboBox fx:id="productCombo" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="3">
                                <Label text="Quantity" styleClass="field-label"/>
                                <Spinner fx:id="qtySpinner" editable="true" prefWidth="110"/>
                            </VBox>
                            <VBox spacing="3">
                                <Label text="Unit Cost (Tk)" styleClass="field-label"/>
                                <TextField fx:id="unitCostField" prefWidth="110"/>
                            </VBox>
                            <Button text="Send Request" styleClass="button-primary" onAction="#handleSendRequest"/>
                        </HBox>
                        <Label fx:id="productHintLabel" text="Choose a supplier to see only the products they provide."
                               styleClass="hint-label" wrapText="true"/>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Restock Requests" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Refresh" styleClass="button-link" onAction="#handleRefresh"/>
                        <Button text="Advance Phase" styleClass="button-secondary" onAction="#handleAdvancePhase"/>
                    </HBox>

                    <TableView fx:id="requestTable" prefHeight="260">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="reqIdColumn" text="Req #" prefWidth="55"/>
                            <TableColumn fx:id="reqSupplierColumn" text="Supplier" prefWidth="150"/>
                            <TableColumn fx:id="reqProductColumn" text="Product" prefWidth="150"/>
                            <TableColumn fx:id="reqQtyColumn" text="Qty" prefWidth="60"/>
                            <TableColumn fx:id="reqUnitCostColumn" text="Unit Cost (Tk)" prefWidth="100"/>
                            <TableColumn fx:id="reqTotalCostColumn" text="Total Cost (Tk)" prefWidth="110"/>
                            <TableColumn fx:id="reqPhaseColumn" text="Phase" prefWidth="100"/>
                            <TableColumn fx:id="reqDateColumn" text="Requested On" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>

</VBox>
