<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderflow.controller.CustomerController" spacing="12">

    <VBox spacing="2">
        <Label text="Customers" styleClass="section-title"/>
        <Label text="Everyone who buys from you - search, edit and open their order history." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by name or phone..." HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Search" styleClass="button-secondary" onAction="#handleSearch"/>
                <Button text="Show All" styleClass="button-link" onAction="#handleShowAll"/>
            </HBox>
            <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="40"/>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="110"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="150"/>
                    <TableColumn fx:id="addressColumn" text="Address" prefWidth="150"/>
                </columns>
            </TableView>
            <Button text="View Order History" styleClass="button-primary" maxWidth="Infinity" onAction="#handleViewHistory"/>
        </VBox>

        <VBox styleClass="panel" spacing="8" minWidth="270" prefWidth="270" maxWidth="270">
            <Label text="Customer Details" styleClass="panel-title"/>
            <Label text="Name" styleClass="field-label"/>
            <TextField fx:id="nameField"/>
            <Label text="Phone" styleClass="field-label"/>
            <TextField fx:id="phoneField"/>
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField"/>
            <Label text="Address" styleClass="field-label"/>
            <TextField fx:id="addressField"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Add Customer" styleClass="button-primary" maxWidth="Infinity" onAction="#handleAdd"/>
            <HBox spacing="8">
                <Button text="Update" styleClass="button-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleUpdate"/>
                <Button text="Delete" styleClass="button-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleDelete"/>
            </HBox>
            <Button text="Clear Form" styleClass="button-link" maxWidth="Infinity" onAction="#handleClear"/>
        </VBox>

    </HBox>

</VBox>
