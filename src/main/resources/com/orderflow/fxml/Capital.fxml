<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderflow.controller.CapitalController" spacing="12">

    <VBox spacing="2">
        <Label text="Capital" styleClass="section-title"/>
        <Label text="The business's own money - every deposit, withdrawal, profit and payout." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <VBox spacing="12" minWidth="270" prefWidth="270" maxWidth="270">
            <VBox styleClass="stat-card, hero-navy" spacing="4" alignment="CENTER_LEFT">
                <Label text="CURRENT CAPITAL" styleClass="stat-card-label"/>
                <Label fx:id="currentCapitalLabel" text="Tk 0.00" styleClass="stat-card-value, hero-value"/>
            </VBox>
            <Button text="Add / Withdraw Capital" styleClass="button-primary" maxWidth="Infinity" onAction="#handleAddCapital"/>
            <Button text="Refresh" styleClass="button-secondary" maxWidth="Infinity" onAction="#handleRefresh"/>
        </VBox>

        <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="History" styleClass="panel-title"/>
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="amountColumn" text="Amount (Tk)" prefWidth="110"/>
                    <TableColumn fx:id="sourceColumn" text="Source" prefWidth="160"/>
                    <TableColumn fx:id="reasonColumn" text="Reason" prefWidth="240"/>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>

    </HBox>

</VBox>
