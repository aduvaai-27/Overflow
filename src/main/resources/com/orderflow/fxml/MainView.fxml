<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.orderflow.controller.MainController">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="12">
            <ImageView fitWidth="34" fitHeight="34">
                <Image url="@../images/logo.png"/>
            </ImageView>
            <Label text="OrderFlow" styleClass="brand-title"/>
            <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome" styleClass="welcome-label"/>
            <Button text="Logout" styleClass="logout-button" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <VBox fx:id="contentArea" styleClass="content-pane"/>
    </center>

    <bottom>
        <VBox styleClass="dock-wrap" alignment="CENTER" spacing="4">
            <HBox styleClass="dock" alignment="CENTER" spacing="4" maxWidth="-Infinity">
                <Button fx:id="btnDashboard" text="Dashboard" contentDisplay="TOP" styleClass="nav-button" onAction="#showDashboard">
                    <graphic><Label text="🏠" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="btnCapital" text="Capital" contentDisplay="TOP" styleClass="nav-button" onAction="#showCapital">
                    <graphic><Label text="💰" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="btnCategories" text="Categories" contentDisplay="TOP" styleClass="nav-button" onAction="#showCategories">
                    <graphic><Label text="🗂" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="btnProducts" text="Products" contentDisplay="TOP" styleClass="nav-button" onAction="#showProducts">
                    <graphic><Label text="📦" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="btnSuppliers" text="Suppliers" contentDisplay="TOP" styleClass="nav-button" onAction="#showSuppliers">
                    <graphic><Label text="🚚" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="btnCustomers" text="Customers" contentDisplay="TOP" styleClass="nav-button" onAction="#showCustomers">
                    <graphic><Label text="👥" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="btnOrders" text="Orders" contentDisplay="TOP" styleClass="nav-button" onAction="#showOrders">
                    <graphic><Label text="🧾" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="btnReports" text="Reports" contentDisplay="TOP" styleClass="nav-button" onAction="#showReports">
                    <graphic><Label text="📊" styleClass="nav-icon"/></graphic>
                </Button>
            </HBox>
            <Label text="OrderFlow  |  Built by Mohammad Adnan Shamim (2307112)" styleClass="footer-text"/>
        </VBox>
    </bottom>

</BorderPane>
