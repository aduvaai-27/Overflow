<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderflow.controller.CategoryController" spacing="12">

    <VBox spacing="2">
        <Label text="Categories" styleClass="section-title"/>
        <Label text="Group your products and see which suppliers cover each group." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS" prefHeight="200">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="nameColumn" text="Category Name" prefWidth="220"/>
                    <TableColumn fx:id="suppliersColumn" text="Suppliers" prefWidth="320"/>
                </columns>
            </TableView>

            <Label fx:id="catalogTitleLabel" text="Select a category to see its suppliers and products" styleClass="panel-title"/>
            <TableView fx:id="catalogTable" VBox.vgrow="ALWAYS" prefHeight="220">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="No supplier / product to show for this category yet."/></placeholder>
                <columns>
                    <TableColumn fx:id="catSupplierColumn" text="Supplier" prefWidth="200"/>
                    <TableColumn fx:id="catProductColumn" text="Product" prefWidth="200"/>
                    <TableColumn fx:id="catPriceColumn" text="Price (Tk)" prefWidth="100"/>
                    <TableColumn fx:id="catSkuColumn" text="Unique ID" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="panel" spacing="8" minWidth="260" prefWidth="260" maxWidth="260">
            <Label text="Category Editor" styleClass="panel-title"/>
            <Label text="Name" styleClass="field-label"/>
            <TextField fx:id="nameField" promptText="Category name"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Add Category" styleClass="button-primary" maxWidth="Infinity" onAction="#handleAdd"/>
            <HBox spacing="8">
                <Button text="Update" styleClass="button-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleUpdate"/>
                <Button text="Delete" styleClass="button-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleDelete"/>
            </HBox>
            <Button text="Clear" styleClass="button-link" maxWidth="Infinity" onAction="#handleClear"/>
        </VBox>

    </HBox>

</VBox>
