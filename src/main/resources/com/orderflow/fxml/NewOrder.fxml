<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderflow.controller.NewOrderController" spacing="16" prefWidth="1040" prefHeight="580">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox styleClass="panel" spacing="8" minWidth="300" prefWidth="300" maxWidth="300">
        <Label text="New Order" styleClass="section-title"/>
        <Label text="Customer" styleClass="field-label"/>
        <ComboBox fx:id="customerCombo" maxWidth="Infinity"/>
        <Label text="Payment Method" styleClass="field-label"/>
        <ComboBox fx:id="paymentMethodCombo" maxWidth="Infinity"/>
        <Label text="Add an item" styleClass="panel-title" style="-fx-padding: 12 0 0 0;"/>
        <Label text="Supplier" styleClass="field-label"/>
        <ComboBox fx:id="supplierCombo" promptText="Choose a supplier" maxWidth="Infinity"/>
        <Label text="Product" styleClass="field-label"/>
        <ComboBox fx:id="productCombo" promptText="Choose a product" maxWidth="Infinity"/>
        <Label fx:id="productHintLabel" text="Choose a supplier to see its products." styleClass="hint-label" wrapText="true"/>
        <VBox fx:id="productDetailBox" styleClass="panel" spacing="2" visible="false" managed="false">
            <Label fx:id="detailIdLabel" styleClass="field-label"/>
            <Label fx:id="detailPriceLabel" styleClass="field-label"/>
            <Label fx:id="detailStockLabel" styleClass="hint-label"/>
        </VBox>
        <Label text="Quantity" styleClass="field-label"/>
        <Spinner fx:id="qtySpinner" editable="true" maxWidth="Infinity"/>
        <Button text="Add to Cart" styleClass="button-secondary" maxWidth="Infinity" onAction="#handleAddToCart"/>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
        <Label text="Cart" styleClass="panel-title"/>
        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="skuColumn" text="Unique ID" prefWidth="90"/>
                <TableColumn fx:id="productColumn" text="Product" prefWidth="170"/>
                <TableColumn fx:id="supplierColumn" text="Supplier" prefWidth="170"/>
                <TableColumn fx:id="qtyColumn" text="Qty" prefWidth="60"/>
                <TableColumn fx:id="unitPriceColumn" text="Unit Price" prefWidth="100"/>
                <TableColumn fx:id="lineTotalColumn" text="Line Total" prefWidth="100"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Remove Selected Item" styleClass="button-link" onAction="#handleRemoveItem"/>
        </HBox>

        <HBox styleClass="stat-card, hero-navy" spacing="24" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="SUBTOTAL (TK)" styleClass="stat-card-label"/>
                <Label fx:id="subtotalLabel" text="0.00" styleClass="stat-card-value, hero-value" style="-fx-font-size: 18px;"/>
            </VBox>
            <VBox spacing="2">
                <Label text="TAX (5%)" styleClass="stat-card-label"/>
                <Label fx:id="taxLabel" text="0.00" styleClass="stat-card-value, hero-value" style="-fx-font-size: 18px;"/>
            </VBox>
            <VBox spacing="2">
                <Label text="DELIVERY" styleClass="stat-card-label"/>
                <Label fx:id="deliveryLabel" text="60.00" styleClass="stat-card-value, hero-value" style="-fx-font-size: 18px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox spacing="2" alignment="CENTER_RIGHT">
                <Label text="GRAND TOTAL (TK)" styleClass="stat-card-label"/>
                <Label fx:id="totalLabel" text="0.00" styleClass="stat-card-value" style="-fx-font-size: 26px; -fx-text-fill: #ffc82e;"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cancel" styleClass="button-secondary" onAction="#handleCancel"/>
            <Button text="Confirm Order" styleClass="button-primary" onAction="#handleConfirm"/>
        </HBox>
    </VBox>

</HBox>
