<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderflow.controller.NewOrderController" spacing="15" prefWidth="640" prefHeight="560">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Create New Order" styleClass="section-title"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Customer:"/>
        <ComboBox fx:id="customerCombo" prefWidth="220" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="stat-card">
        <Label text="Product:"/>
        <ComboBox fx:id="productCombo" prefWidth="220"/>
        <Label text="Qty:"/>
        <Spinner fx:id="qtySpinner" prefWidth="80" editable="true"/>
        <Button text="Add to Cart" styleClass="button-secondary" onAction="#handleAddToCart"/>
    </HBox>

    <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="productColumn" text="Product" prefWidth="220"/>
            <TableColumn fx:id="qtyColumn" text="Qty" prefWidth="60"/>
            <TableColumn fx:id="unitPriceColumn" text="Unit Price" prefWidth="100"/>
            <TableColumn fx:id="lineTotalColumn" text="Line Total" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Remove Selected Item" styleClass="button-danger" onAction="#handleRemoveItem"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="stat-card">
        <VBox spacing="4">
            <Label text="Subtotal (Tk):"/>
            <Label fx:id="subtotalLabel" text="0.00" styleClass="stat-card-value"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Tax (5%):"/>
            <Label fx:id="taxLabel" text="0.00" styleClass="stat-card-value"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Delivery Charge:"/>
            <Label fx:id="deliveryLabel" text="60.00" styleClass="stat-card-value"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Grand Total (Tk):"/>
            <Label fx:id="totalLabel" text="0.00" styleClass="stat-card-value"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Payment Method:"/>
        <ComboBox fx:id="paymentMethodCombo" prefWidth="180"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="button-secondary" onAction="#handleCancel"/>
        <Button text="Confirm Order" styleClass="button-primary" onAction="#handleConfirm"/>
    </HBox>

</VBox>
