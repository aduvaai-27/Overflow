<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderflow.controller.OrderController" spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Orders" styleClass="section-title"/>
            <Label text="Track every sale from confirmation to completion." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" styleClass="button-link" onAction="#handleRefresh"/>
        <Button text="+ New Order" styleClass="button-primary" onAction="#handleNewOrder"/>
    </HBox>

    <HBox styleClass="panel" spacing="10" alignment="CENTER_LEFT">
        <Label text="Selected order:" styleClass="field-label"/>
        <Button text="View Invoice" styleClass="button-secondary" onAction="#handleViewInvoice"/>
        <Button text="Advance Status" styleClass="button-secondary" onAction="#handleAdvanceStatus"/>
        <Button fx:id="markPaidButton" text="Mark COD Collected" styleClass="button-secondary" onAction="#handleMarkPaid">
            <tooltip>
                <Tooltip text="Enabled once the selected order is Delivered (or Completed) and not already Paid."/>
            </tooltip>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelOrderButton" text="Cancel Order" styleClass="button-danger" onAction="#handleCancelOrder">
            <tooltip>
                <Tooltip text="Enabled while the selected order hasn't shipped yet."/>
            </tooltip>
        </Button>
    </HBox>

    <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="idColumn" text="Order #" prefWidth="70"/>
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="150"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
            <TableColumn fx:id="totalColumn" text="Total (Tk)" prefWidth="90"/>
            <TableColumn fx:id="paymentMethodColumn" text="Payment Method" prefWidth="120"/>
            <TableColumn fx:id="paymentStatusColumn" text="Payment Status" prefWidth="110"/>
            <TableColumn fx:id="orderStatusColumn" text="Order Status" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
