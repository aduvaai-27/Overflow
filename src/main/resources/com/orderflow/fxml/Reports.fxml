<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.orderflow.controller.ReportController" fitToWidth="true" styleClass="tab-scroll">
<VBox spacing="14" style="-fx-padding: 6 10 20 10;">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Reports" styleClass="section-title"/>
            <Label text="Pick a date range to see how sales performed." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="From" styleClass="field-label"/>
        <DatePicker fx:id="fromDatePicker" prefWidth="140"/>
        <Label text="To" styleClass="field-label"/>
        <DatePicker fx:id="toDatePicker" prefWidth="140"/>
        <Button text="Generate" styleClass="button-primary" onAction="#handleGenerate"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="stat-card, hero-navy" alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="ORDERS IN RANGE" styleClass="stat-card-label"/>
            <Label fx:id="orderCountLabel" text="0" styleClass="stat-card-value, hero-value"/>
        </VBox>
        <VBox styleClass="stat-card, hero-orange" alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="REVENUE IN RANGE (TK)" styleClass="stat-card-label"/>
            <Label fx:id="revenueLabel" text="0.00" styleClass="stat-card-value, hero-value"/>
        </VBox>
        <VBox styleClass="stat-card, tile-teal" alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Average Order Value (Tk)" styleClass="stat-card-label"/>
            <Label fx:id="avgOrderLabel" text="0.00" styleClass="stat-card-value"/>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="stat-card, tile-yellow" spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Highest Selling Product (by quantity bought)" styleClass="stat-card-label"/>
            <BarChart fx:id="topSellingChart" prefHeight="280" categoryGap="40" animated="false">
                <xAxis><CategoryAxis label="Product" tickLabelRotation="0"/></xAxis>
                <yAxis><NumberAxis label="Units sold"/></yAxis>
            </BarChart>
        </VBox>
        <VBox styleClass="stat-card, tile-navy" spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Highest Revenue Generating Product" styleClass="stat-card-label"/>
            <BarChart fx:id="topRevenueChart" prefHeight="280" categoryGap="40" animated="false">
                <xAxis><CategoryAxis label="Product" tickLabelRotation="0"/></xAxis>
                <yAxis><NumberAxis label="Revenue (Tk)"/></yAxis>
            </BarChart>
        </VBox>
    </HBox>

    <Label text="Orders in this range" styleClass="panel-title"/>
    <TableView fx:id="reportTable" prefHeight="260">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="idColumn" text="Order #" prefWidth="70"/>
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="150"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
            <TableColumn fx:id="totalColumn" text="Total (Tk)" prefWidth="90"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>
</ScrollPane>
