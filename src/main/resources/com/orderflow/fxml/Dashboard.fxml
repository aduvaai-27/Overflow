<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.orderflow.controller.DashboardController" fitToWidth="true">
<VBox spacing="20" style="-fx-padding: 0 4 20 0;">

    <Label text="Business Overview" styleClass="section-title"/>

    <Label text="SALES" styleClass="dashboard-group-label"/>
    <HBox spacing="15">
        <VBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4" style="-fx-border-color: #101433; -fx-border-width: 0 0 0 4;">
            <Label text="Total Orders" styleClass="stat-card-label"/>
            <Label fx:id="totalOrdersLabel" text="0" styleClass="stat-card-value"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4" style="-fx-border-color: #101433; -fx-border-width: 0 0 0 4;">
            <Label text="Total Revenue (Tk)" styleClass="stat-card-label"/>
            <Label fx:id="totalRevenueLabel" text="0" styleClass="stat-card-value"/>
            <Label fx:id="totalRevenueUsdLabel" text="" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4" style="-fx-border-color: #101433; -fx-border-width: 0 0 0 4;">
            <Label text="Pending COD Orders" styleClass="stat-card-label"/>
            <Label fx:id="pendingCodLabel" text="0" styleClass="stat-card-value"/>
        </VBox>
    </HBox>

    <Label text="CUSTOMERS" styleClass="dashboard-group-label"/>
    <HBox spacing="15">
        <VBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4" style="-fx-border-color: #101433; -fx-border-width: 0 0 0 4;">
            <Label text="Total Customers" styleClass="stat-card-label"/>
            <Label fx:id="totalCustomersLabel" text="0" styleClass="stat-card-value"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4" style="-fx-border-color: #101433; -fx-border-width: 0 0 0 4;">
            <Label text="Best Customer (most orders)" styleClass="stat-card-label"/>
            <Label fx:id="bestCustomerLabel" text="-" styleClass="stat-card-value" style="-fx-font-size: 15px;"/>
        </VBox>
    </HBox>

    <Label text="INVENTORY" styleClass="dashboard-group-label"/>
    <HBox spacing="15">
        <VBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4" style="-fx-border-color: #101433; -fx-border-width: 0 0 0 4;">
            <Label text="Total Products" styleClass="stat-card-label"/>
            <Label fx:id="totalProductsLabel" text="0" styleClass="stat-card-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-alert" alignment="CENTER_LEFT" spacing="4" style="-fx-border-color: #dc2626; -fx-border-width: 0 0 0 4;">
            <Label text="Low Stock Alerts (live)" styleClass="stat-card-label"/>
            <Label fx:id="lowStockLabel" text="checking..." styleClass="stat-card-value"/>
        </VBox>
    </HBox>

    <Label text="FINANCE" styleClass="dashboard-group-label"/>
    <HBox spacing="15">
        <VBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4" style="-fx-border-color: #101433; -fx-border-width: 0 0 0 4;">
            <Label text="Capital (Tk)" styleClass="stat-card-label"/>
            <Label fx:id="capitalLabel" text="0" styleClass="stat-card-value"/>
            <Label fx:id="capitalUsdLabel" text="" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
        </VBox>
    </HBox>

    <Label text="TRENDS" styleClass="dashboard-group-label"/>
    <VBox styleClass="stat-card" spacing="8">
        <Label text="Monthly Profit - Sell price minus Buy price (stock not counted)" styleClass="stat-card-label"/>
        <BarChart fx:id="monthlyProfitChart" prefHeight="280" categoryGap="90" barGap="0" maxWidth="560" animated="false">
            <xAxis><CategoryAxis label="Month"/></xAxis>
            <yAxis><NumberAxis label="Profit (Tk)"/></yAxis>
        </BarChart>
    </VBox>

</VBox>
</ScrollPane>
