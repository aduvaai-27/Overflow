<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderflow.controller.ProductController" spacing="12">

    <VBox spacing="2">
        <Label text="Products" styleClass="section-title"/>
        <Label text="Your stock catalogue - add items, set prices and watch minimum levels." styleClass="page-subtitle"/>
    </VBox>

    <HBox styleClass="panel" spacing="18" alignment="CENTER_LEFT">
        <GridPane hgap="14" vgap="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            </columnConstraints>

            <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Name" styleClass="field-label"/>
                <TextField fx:id="nameField"/>
            </VBox>
            <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="Unique ID" styleClass="field-label"/>
                <TextField fx:id="skuField" promptText="Auto if left blank"/>
            </VBox>
            <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="2">
                <Label text="Category" styleClass="field-label"/>
                <ComboBox fx:id="categoryCombo" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="3" GridPane.rowIndex="0" GridPane.columnIndex="3">
                <Label text="Supplier" styleClass="field-label"/>
                <ComboBox fx:id="supplierCombo" promptText="Choose a supplier" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="3" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="Purchase Price" styleClass="field-label"/>
                <TextField fx:id="purchasePriceField"/>
            </VBox>
            <VBox spacing="3" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label text="Selling Price" styleClass="field-label"/>
                <TextField fx:id="sellingPriceField"/>
            </VBox>
            <VBox spacing="3" GridPane.rowIndex="1" GridPane.columnIndex="2">
                <Label text="Stock Qty" styleClass="field-label"/>
                <TextField fx:id="stockQtyField"/>
            </VBox>
            <VBox spacing="3" GridPane.rowIndex="1" GridPane.columnIndex="3">
                <Label text="Min Stock" styleClass="field-label"/>
                <TextField fx:id="minStockField"/>
            </VBox>
        </GridPane>

        <VBox spacing="8" minWidth="150" prefWidth="150">
            <Button text="Add Product" styleClass="button-primary" maxWidth="Infinity" onAction="#handleAdd"/>
            <Button text="Update Selected" styleClass="button-secondary" maxWidth="Infinity" onAction="#handleUpdate"/>
            <Button text="Deactivate" styleClass="button-danger" maxWidth="Infinity" onAction="#handleDeactivate"/>
            <Button text="Clear Form" styleClass="button-link" maxWidth="Infinity" onAction="#handleClear"/>
        </VBox>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search by name or Unique ID..." HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Search" styleClass="button-secondary" onAction="#handleSearch"/>
        <Button text="Show All" styleClass="button-link" onAction="#handleShowAll"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS" prefHeight="220">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="40"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
            <TableColumn fx:id="skuColumn" text="Unique ID" prefWidth="90"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="100"/>
            <TableColumn fx:id="supplierColumn" text="Supplier" prefWidth="150"/>
            <TableColumn fx:id="purchasePriceColumn" text="Purchase Price" prefWidth="100"/>
            <TableColumn fx:id="sellingPriceColumn" text="Selling Price" prefWidth="100"/>
            <TableColumn fx:id="stockColumn" text="Stock" prefWidth="70"/>
            <TableColumn fx:id="minStockColumn" text="Min Stock" prefWidth="80"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
        </columns>
    </TableView>

</VBox>
